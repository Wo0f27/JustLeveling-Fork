{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Senior-S/JustLeveling-Fork",
        "sources": "https://github.com/Senior-S/JustLeveling-Fork",
        "issues": "https://github.com/Senior-S/JustLeveling-Fork/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.seniors.justlevelingfork.JustLevelingFabric"
        ],
        "client": [
            "com.seniors.justlevelingfork.JustLevelingFabricClient"
        ],
        "modmenu": [
            "com.seniors.justlevelingfork.compat.JustLevelingModMenu"
        ]
    },
    "mixins": [
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17"
    },
    "suggests": {
        "modmenu": "*",
        "trinkets": "*",
        "kubejs": "*",
        "rhino": "*",
        "architectury": "*",
        "ftbquests": "*",
        "ftblibrary": "*",
        "questlog": "*"
    }
}
  
